{"metadata":{"cellCounter":8},"cells":[{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-1","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nSELECT * WHERE { ?s ?p ?o } LIMIT 10"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-3","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nSELECT (COUNT(*) AS ?triples)\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?subject ?predicate ?object\r\n  }\r\n}"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-4","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nPREFIX qcsm: <https://quantifarm.eu/ontology/>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\n\r\nSELECT ?dat ?label\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?dat a qcsm:DigitalAgriculturalTechnology ;\r\n         rdfs:label ?label .\r\n  }\r\n}\r\nLIMIT 10"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-5","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nPREFIX qcsm: <https://quantifarm.eu/ontology/>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\n\r\nSELECT ?dat ?label\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?dat a qcsm:DigitalAgriculturalTechnology ;\r\n         rdfs:label ?label .\r\n  }\r\n}\r\nORDER BY LCASE(STR(?label))\r\nLIMIT 10"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-6","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nSELECT ?graph (COUNT(*) AS ?triples)\r\nWHERE {\r\n  GRAPH ?graph {\r\n    ?subject ?predicate ?object\r\n  }\r\n}\r\nGROUP BY ?graph\r\nORDER BY ?graph"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-7","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nPREFIX qcsm: <https://quantifarm.eu/ontology/>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\n\r\nSELECT ?dat ?label ?testcase\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?dat a qcsm:DigitalAgriculturalTechnology ;\r\n         rdfs:label ?label ;\r\n         qcsm:isUsedInTestcase ?testcase .\r\n  }\r\n}\r\nORDER BY LCASE(STR(?label))"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a","slug":"cell-8","slugIsAuto":true},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nPREFIX qcsm: <https://quantifarm.eu/ontology/>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\n\r\nSELECT ?dat ?label\r\n       (IF(BOUND(?testcase), \"yes\", \"no\") AS ?tested)\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?dat a qcsm:DigitalAgriculturalTechnology ;\r\n         rdfs:label ?label .\r\n\r\n    OPTIONAL {\r\n      ?dat qcsm:isUsedInTestcase ?testcase .\r\n    }\r\n  }\r\n}\r\nORDER BY DESC(?tested) LCASE(STR(?label))\r\nLIMIT 100"},{"kind":2,"language":"sparql","metadata":{"connectionId":"180a8d80-cbfe-4ae7-973f-80469ba9b28a"},"value":"# @endpoint http://localhost:3030/quantifarm/query\r\n\r\nPREFIX qcsm: <https://quantifarm.eu/ontology/>\r\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\r\n\r\nSELECT ?dat ?label ?sector\r\nWHERE {\r\n  GRAPH <https://quantifarm.eu/graphs/dats> {\r\n    ?dat a qcsm:DigitalAgriculturalTechnology ;\r\n         rdfs:label ?label ;\r\n         qcsm:isTargetedTowardsAgriculturalSector ?sector .\r\n  }\r\n}\r\nORDER BY LCASE(STR(?label)) LCASE(STR(?sector))"}]}