# MySQL Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=

# Web Application Database Connection
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=

# Only this account (lowercase email) may grant/revoke admin rights via admin-users.html.
# The first admin account itself must still be set manually in the DB (UPDATE users SET isadmin=1 ...).
SUPER_ADMIN_EMAIL=

# Shared secret for triggering a data refresh in the recommendation tool after DAT changes.
# Must be identical to REFRESH_TOKEN in packages/recommendation-tool/.env
REFRESH_TOKEN=
