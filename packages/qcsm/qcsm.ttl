qcsm:hasTotalFarmSize
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "The total size of the farm area in square meters (possibly the under water area in case of aquaculture)" ;
  rdfs:domain qcsm:FarmInformation ;
  rdfs:label "has total farm size" ;
  rdfs:range xsd:decimal ;
.
qcsm:hasTotalFuelUsage
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "The total amount of fuel used in liters per hectare in the specific year of the cultivation" ;
  rdfs:domain qcsm:FuelUsageInformation ;
  rdfs:label "has total fuel usage" ;
  rdfs:range xsd:decimal ;
.
qcsm:hasTotalNumberOfCalvesBorn
  rdf:type owl:DatatypeProperty ;
