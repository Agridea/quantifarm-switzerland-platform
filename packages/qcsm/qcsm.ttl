  rdfs:subClassOf qcsm:TestcaseInformation ;
.
qcsm:CalculatedSustainabilityInformation
  rdf:type owl:Class ;
  rdfs:comment "Sustainability parameter that indicates how well the DATS performed in the specific year" ;
  rdfs:label "Calculated Sustainability Information" ;
  rdfs:subClassOf qcsm:TestcaseInformation ;
.
qcsm:AggregatedImpactInformation
