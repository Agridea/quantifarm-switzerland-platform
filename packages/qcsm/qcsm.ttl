qcsm:hasImpactLevel
  rdf:type owl:DatatypeProperty ;
  rdfs:comment "The level of the impact of the parameter, 0=negative, 1=positive, 2=neutral, 3=DATS" ;
  rdfs:domain qcsm:MainImpactInformation ;
  rdfs:label "has impact level" ;
  rdfs:range xsd:decimal ;
