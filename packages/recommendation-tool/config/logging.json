{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "main": {
            "format": "%(levelname)s |%(asctime)s| %(name)s -> %(message)s",
            "datefmt": "%d/%m %H:%M:%S",
            "class": "src.config.FixedWidthFormatter"
        }
    },
    "handlers": {
        "stdout": {
            "class": "logging.StreamHandler",
            "level": "DEBUG",
            "formatter": "main",
            "stream": "ext://sys.stdout"
        }
    },
    "loggers": {
        "root": {"level": "DEBUG"},
        "App": {"level": "INFO"},
        "Triple-Store": {"level": "INFO"},
        "Farmer-Profile": {"level": "INFO"},
        "DATS-Graph": {"level": "INFO"}
    }
}